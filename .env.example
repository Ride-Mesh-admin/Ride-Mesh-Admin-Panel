# Copy to .env.local (never commit secrets).

# Optional explicit service-account JSON path (recommended for local):
FIREBASE_SERVICE_ACCOUNT_PATH=../ride-mesh-firebase-adminsdk-fbsvc-350a8fa8e1.json

# Or set these three instead of a JSON file:
# FIREBASE_PROJECT_ID=ride-mesh
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-...@ride-mesh.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Admin login (defaults exist in code for local only)
# ADMIN_EMAIL=Kristopher@ridemesh.app
# ADMIN_PASSWORD=KP@3000$

# Session signing secret (set a long random string in production)
# ADMIN_SESSION_SECRET=

# Public URL of this admin app (used in password-reset emails)
# ADMIN_APP_URL=https://admin.ride-mesh.app

# Firestore user id used as the chat sender for “Notify host” (creates users/{id} as RideMesh Admin)
# ADMIN_CHAT_SENDER_ID=ridemesh_admin

# Google Maps JavaScript API (Safety Operations map). Same key as mobile if referrers allow localhost.
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Resend API — newsletter delivery + admin password-reset emails
# RESEND_API_KEY=re_xxx
# RESEND_FROM_EMAIL=RideMesh <support@your-verified-domain.com>
# RESEND_REPLY_TO=support@your-verified-domain.com
# NEWSLETTER_SITE_URL=https://ride-mesh.app

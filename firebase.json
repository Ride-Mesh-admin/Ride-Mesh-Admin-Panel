{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": {
    "source": "functions"
  },
  "apphosting": [
    {
      "backendId": "ride-mesh-admin",
      "rootDir": ".",
